// ==UserScript==
// @name         YouTube: Ralf Schumacher Ad-Blocker (Mute & Blackout + Embeds)
// @namespace    http://violentmonkey.net
// @version      1.3
// @description  Schwärzt das Video mit Hinweis-Text, schaltet stumm und funktioniert auch bei eingebetteten Videos.
// @author       80sKid
// @match        https://youtube.com/*
// @match        https://youtube-nocookie.com/*
// @match        https://www.youtube.com/*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    // Schlüsselwörter, auf die reagiert werden soll (Kleinschreibung verwenden)
    const KEYWORDS = ['ralf schumacher', 'ralf-schumacher', 'wirkaufendeinauto'];

    let isMutedByScript = false;
    let wasMutedBeforeAd = false;
    let isTestMode = false;
    let testTimeout = null;

    // Erstellt ein schwarzes Overlay mit weißem Schriftzug für den Video-Player
    function createBlackoutOverlay() {
        let overlay = document.getElementById('ralf-ad-blackout');
        if (!overlay) {
            overlay = document.createElement('div');
            overlay.id = 'ralf-ad-blackout';
            Object.assign(overlay.style, {
                position: 'absolute',
                top: '0',
                left: '0',
                width: '100%',
                height: '100%',
                backgroundColor: '#000000',
                color: '#FFFFFF',
                display: 'none',
                alignItems: 'center',
                justifyContent: 'center',
                textAlign: 'center',
                padding: '20px',
                boxSizing: 'border-box',
                zIndex: '40',
                pointerEvents: 'none',
                fontSize: 'clamp(16px, 3vw, 24px)', // Passt sich flexibel an kleine Embed-Player an
                fontWeight: 'bold',
                fontFamily: 'YouTube Sans, Roboto, sans-serif'
            });
            overlay.innerText = 'blende nervige Renn-Ralle-Werbung aus';

            const player = document.querySelector('#movie_player');
            if (player) {
                player.appendChild(overlay);
            }
        }
        return overlay;
    }

    function activateBlackout(video, overlay) {
        if (overlay.style.display !== 'flex') {
            overlay.style.display = 'flex';
        }
        if (!isMutedByScript) {
            wasMutedBeforeAd = video.muted;
            video.muted = true;
            isMutedByScript = true;
        }
    }

    function deactivateBlackout(video, overlay) {
        if (overlay && overlay.style.display !== 'none') {
            overlay.style.display = 'none';
        }
        if (isMutedByScript) {
            video.muted = wasMutedBeforeAd;
            isMutedByScript = false;
        }
    }

    function checkAdStatus() {
        const player = document.querySelector('#movie_player');
        const video = document.querySelector('video');
        if (!player || !video) return;

        const overlay = createBlackoutOverlay();

        // Wenn der Test-Modus aktiv ist, Blackout erzwingen
        if (isTestMode) {
            activateBlackout(video, overlay);
            return;
        }

        // Prüfen, ob gerade grundsätzlich Werbung läuft
        const isAdShowing = player.classList.contains('ad-showing') || player.classList.contains('ad-interrupting');

        if (isAdShowing) {
            // Text aus dem Werbe-Overlay und den Werbe-Infos auslesen
            const adModule = document.querySelector('.ytp-ad-player-overlay, .ytp-ad-player-overlay-layout');
            const adText = adModule ? adModule.innerText.toLowerCase() : '';

            // Prüfen, ob eines der Schlüsselwörter vorkommt
            const isTargetAd = KEYWORDS.some(keyword => adText.includes(keyword));

            if (isTargetAd) {
                activateBlackout(video, overlay);
                return;
            }
        }

        // Normalzustand wiederherstellen
        deactivateBlackout(video, overlay);
    }

    // Test-Taste: Alt + T (löst 3 Sekunden Test-Ausblendung aus)
    document.addEventListener('keydown', function(e) {
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName) || document.activeElement.isContentEditable) {
            return;
        }

        if (e.altKey && e.key.toLowerCase() === 't') {
            e.preventDefault();
            clearTimeout(testTimeout);
            isTestMode = true;
            checkAdStatus();

            testTimeout = setTimeout(() => {
                isTestMode = false;
                checkAdStatus();
            }, 3000);
        }
    });

    // Überwacht Änderungen im YouTube-Player in Echtzeit
    const observer = new MutationObserver(() => {
        checkAdStatus();
    });

    // Startet die Überwachung, sobald der Player geladen ist
    function init() {
        const player = document.querySelector('#movie_player');
        if (player) {
            observer.observe(player, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['class']
            });
        } else {
            setTimeout(init, 500);
        }
    }

    init();
})();
