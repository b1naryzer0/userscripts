// ==UserScript==
// @name         YouTube: Ralf Schumacher Ad-Blocker (Werbung & direkte Videos)
// @namespace    http://violentmonkey.net
// @version      1.4
// @description  Schwärzt Werbung UND direkte Videos mit Ralf Schumacher / wirkaufendeinauto.de und schaltet sie stumm.
// @author       80sKid
// @match        https://*.youtube.com/*
// @match        https://youtube-nocookie.com/*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    const KEYWORDS = ['ralf schumacher', 'ralf-schumacher', 'wirkaufendeinauto', 'schumachers empfehlung'];

    let isBlockingActive = false;
    let wasMutedBeforeAd = false;
    let isTestMode = false;
    let testTimeout = null;

    function createBlackoutOverlay() {
        let overlay = document.getElementById('ralf-ad-blackout');
        if (!overlay) {
            overlay = document.createElement('div');
            overlay.id = 'ralf-ad-blackout';
            Object.assign(overlay.style, {
                position: 'absolute',
                top: '0',
                left: '0',
                width: '100%',
                height: '100%',
                backgroundColor: '#000000',
                color: '#FFFFFF',
                display: 'none',
                alignItems: 'center',
                justifyContent: 'center',
                textAlign: 'center',
                padding: '20px',
                boxSizing: 'border-box',
                zIndex: '40',
                pointerEvents: 'none',
                fontSize: 'clamp(16px, 3vw, 24px)',
                fontWeight: 'bold',
                fontFamily: 'YouTube Sans, Roboto, sans-serif'
            });
            overlay.innerText = 'blende nervige Renn-Ralle-Werbung aus';

            const player = document.querySelector('#movie_player');
            if (player) {
                player.appendChild(overlay);
            }
        }
        return overlay;
    }

    function activateBlackout(video, overlay) {
        if (overlay && overlay.style.display !== 'flex') {
            overlay.style.display = 'flex';
        }

        // Ursprünglichen Ton-Status nur beim allerersten Aktivieren merken
        if (!isBlockingActive) {
            wasMutedBeforeAd = video.muted;
            isBlockingActive = true;
        }

        // Stummschaltung konsequent erzwingen, falls YouTube sie zurücksetzt
        if (!video.muted) {
            video.muted = true;
        }
    }

    function deactivateBlackout(video, overlay) {
        if (overlay && overlay.style.display !== 'none') {
            overlay.style.display = 'none';
        }
        if (isBlockingActive) {
            video.muted = wasMutedBeforeAd;
            isBlockingActive = false;
        }
    }

    function containsKeyword(text) {
        if (!text) return false;
        const lowerText = text.toLowerCase();
        return KEYWORDS.some(keyword => lowerText.includes(keyword));
    }

    function checkAdStatus() {
        const player = document.querySelector('#movie_player');
        const video = document.querySelector('video');
        if (!player || !video) return;

        // Listener direkt an das Video hängen, falls YouTube den Ton ändert
        if (!video.dataset.ralfListenerAttached) {
            video.addEventListener('volumechange', () => {
                if (isBlockingActive && !video.muted) {
                    video.muted = true;
                }
            });
            video.dataset.ralfListenerAttached = 'true';
        }

        const overlay = createBlackoutOverlay();

        // 1. Test-Modus (Alt + T)
        if (isTestMode) {
            activateBlackout(video, overlay);
            return;
        }

        // 2. Prüfen, ob gerade ein Werbespot (Ad) läuft
        const isAdShowing = player.classList.contains('ad-showing') || player.classList.contains('ad-interrupting');
        if (isAdShowing) {
            const adModule = document.querySelector('.ytp-ad-player-overlay, .ytp-ad-player-overlay-layout');
            const adText = adModule ? adModule.innerText : '';
            if (containsKeyword(adText)) {
                activateBlackout(video, overlay);
                return;
            }
        } else {
            // 3. Prüfen, ob das reguläre Video selbst ein Werbevideo ist
            const videoTitle = document.querySelector('h1.ytd-watch-metadata, .ytp-title-link')?.innerText || document.title;
            const channelName = document.querySelector('#owner #channel-name, .ytp-title-channel-name')?.innerText || '';
            const description = document.querySelector('#description-inline-expander')?.innerText || '';

            if (containsKeyword(videoTitle) || containsKeyword(channelName) || containsKeyword(description)) {
                activateBlackout(video, overlay);
                return;
            }
        }

        // Normalzustand wiederherstellen
        deactivateBlackout(video, overlay);
    }

    // Test-Taste: Alt + T
    document.addEventListener('keydown', function(e) {
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName) || document.activeElement.isContentEditable) {
            return;
        }

        if (e.altKey && e.key.toLowerCase() === 't') {
            e.preventDefault();
            clearTimeout(testTimeout);
            isTestMode = true;
            checkAdStatus();

            testTimeout = setTimeout(() => {
                isTestMode = false;
                checkAdStatus();
            }, 3000);
        }
    });

    // Überwacht Änderungen auf der gesamten Seite
    const observer = new MutationObserver(() => {
        checkAdStatus();
    });

    function init() {
        if (document.body) {
            observer.observe(document.body, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['class']
            });
            checkAdStatus();
        } else {
            setTimeout(init, 500);
        }
    }

    init();
})();
